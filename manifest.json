{
  "manifest_version": 3,
  "name": "Social Media Scraper",
  "version": "1.0",
  "description": "Scraps recent posts from Twitter and Reddit",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.reddit.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrape Posts"
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*", "https://www.reddit.com/*"],
      "js": ["content.js"]
    }
  ]
}